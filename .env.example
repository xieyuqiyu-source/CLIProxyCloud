CP_CLOUD_APP_ENV=development
CP_CLOUD_ADDR=:8090
CP_CLOUD_MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/cliproxy_cloud?charset=utf8mb4&parseTime=True&loc=Local
CP_CLOUD_JWT_SECRET=replace-with-a-long-random-secret
CP_CLOUD_STORAGE_ROOT=./storage
CP_CLOUD_STORAGE_KEY=replace-with-32-byte-hex-or-plain-secret
CP_CLOUD_PUBLIC_BASE_URL=http://127.0.0.1:8090
CP_CLOUD_ADMIN_EMAIL=admin@example.com
CP_CLOUD_ADMIN_PASSWORD=change-this-password

# WeChat Pay Native (API v3)
CP_CLOUD_WECHAT_ENABLED=false
CP_CLOUD_WECHAT_APP_ID=
CP_CLOUD_WECHAT_MCH_ID=
CP_CLOUD_WECHAT_SERIAL_NO=
CP_CLOUD_WECHAT_PRIVATE_KEY_PEM=
CP_CLOUD_WECHAT_PRIVATE_KEY_PATH=
CP_CLOUD_WECHAT_API_V3_KEY=
CP_CLOUD_WECHAT_NOTIFY_URL=
CP_CLOUD_WECHAT_GATEWAY=https://api.mch.weixin.qq.com
CP_CLOUD_WECHAT_PLATFORM_CERT_PEM=
CP_CLOUD_WECHAT_PLATFORM_SERIAL_NO=

# Alipay Face-to-Face / Precreate
CP_CLOUD_ALIPAY_ENABLED=false
CP_CLOUD_ALIPAY_APP_ID=
CP_CLOUD_ALIPAY_PRIVATE_KEY_PEM=
CP_CLOUD_ALIPAY_PRIVATE_KEY_PATH=
CP_CLOUD_ALIPAY_PUBLIC_KEY_PEM=
CP_CLOUD_ALIPAY_NOTIFY_URL=
CP_CLOUD_ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
