CP_CLOUD_APP_ENV=development
CP_CLOUD_ADDR=:8090
CP_CLOUD_MYSQL_DSN=root:password@tcp(127.0.0.1:3306)/cliproxy_cloud?charset=utf8mb4&parseTime=True&loc=Local
CP_CLOUD_JWT_SECRET=replace-with-a-long-random-secret
CP_CLOUD_STORAGE_ROOT=./storage
CP_CLOUD_STORAGE_KEY=replace-with-32-byte-hex-or-plain-secret
CP_CLOUD_PUBLIC_BASE_URL=http://127.0.0.1:8090
CP_CLOUD_ADMIN_EMAIL=admin@example.com
CP_CLOUD_ADMIN_PASSWORD=change-this-password

# XunhuPay personal payment
CP_CLOUD_XUNHU_ENABLED=false
CP_CLOUD_XUNHU_APP_ID=
CP_CLOUD_XUNHU_SECRET=
CP_CLOUD_XUNHU_NOTIFY_URL=
CP_CLOUD_XUNHU_RETURN_URL=
CP_CLOUD_XUNHU_CALLBACK_URL=
CP_CLOUD_XUNHU_GATEWAY=https://api.xunhupay.com/payment/do.html
CP_CLOUD_XUNHU_QUERY_URL=https://api.xunhupay.com/payment/query.html
